{
  "name": "whatsapp-system-design",
  "version": "1.0.0",
  "private": true,
  "description": "Sign up and log in for the Chorus group chat app (React + Express + MySQL)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.js\" \"vite --config client/vite.config.mjs\"",
    "build": "vite build --config client/vite.config.mjs",
    "prestart": "npm run build",
    "start": "node server/index.js"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^6.4.6"
  }
}
